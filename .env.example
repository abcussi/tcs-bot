# ---------- runtime ----------
APP_ENV=local                       # local | test | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------- LLM / embeddings ----------
# LLM_PROVIDER=openai uses OpenAI; LLM_PROVIDER=fake uses the deterministic offline stack (tests / no key)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0
RAG_TOP_K=6
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ---------- MySQL (system of record) ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vendor_risk
MYSQL_USER=vendor_risk
MYSQL_PASSWORD=vendor_risk_pw
MYSQL_ROOT_PASSWORD=root_pw
MYSQL_POOL_NAME=vendor_risk_pool
MYSQL_POOL_SIZE=10

# ---------- Elasticsearch (market data + document chunks) ----------
ELASTIC_URL=http://127.0.0.1:9200
ELASTIC_QUOTES_INDEX=market-quotes
ELASTIC_CHUNKS_INDEX=vendor-chunks

# ---------- Redis (L2 cache) + in-process L1 cache ----------
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900
LOCAL_CACHE_MAXSIZE=512

# ---------- Seed ----------
SEED_FILE=data/seed/vendors.json

# ---------- Crawler ----------
CRAWLER_TICKERS=AAPL:NASDAQ,MSFT:NASDAQ,JPM:NYSE,GS:NYSE,MS:NYSE,IBM:NYSE,ORCL:NYSE,ICE:NYSE
CRAWLER_CRON=*/15 * * * *
CRAWLER_BASE_URL=https://www.google.com/finance/quote
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36

# ---------- TCS risk medallion pipeline (spec 005) ----------
GOLD_INDEX_PREFIX=gold-tcs-risk
MEDALLION_MAX_DOCS=500
MEDALLION_MAX_DEPTH=2
MEDALLION_RELEVANCE_THRESHOLD=0.35
SILVER_INDEX=silver-tcs-risk
GOLD_DIR=data/gold
GOLD_GRAPH_K=5
GOLD_GRAPH_MIN_COSINE=0.35
LSA_DIM=256
